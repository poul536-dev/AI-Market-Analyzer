<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AIMarketAnalyzer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorPrimary">@color/bg_secondary</item>
        <item name="colorPrimaryDark">@color/status_bar</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.AIMarketAnalyzer.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
